# Copy this file to .env and fill in your keys from https://dashboard.plaid.com/developers/keys
# .env is git-ignored, so your keys are never committed.
#   npm run dev   -> put .env in this project folder
#   desktop app   -> put .env in %APPDATA%\Finance Dashboard\
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
